{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/xscore run build && cp -r artifacts/xscore/dist ./out",
  "outputDirectory": "out",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
